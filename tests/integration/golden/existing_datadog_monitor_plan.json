  "datadog_monitor.alerts[\"deployment-replica-mismatch\"]": {
    "include_tags": true,
    "message": "Deployment {{kube_deployment.name}} in namespace {{kube_namespace.name}} on cluster {{kube_cluster_name.name}} has less than 80% replicas available.\n\nRunbook: https://runbooks.divyam.ai/kubernetes/deployment-replica-mismatch\n\n@webhook-divyam-pager-0",
    "monitor_thresholds": [
      {
        "critical": "0.8",
        "critical_query": null,
        "critical_recovery": "0.85",
        "critical_recovery_query": null,
        "ok": null,
        "unknown": null,
        "warning": "0.9",
        "warning_recovery": "0.95"
      }
    ],
    "name": "deployment-replica-mismatch",
    "no_data_timeframe": 15,
    "notify_no_data": true,
    "priority": "1",
    "query": "min(last_15m):(avg:kubernetes_state.deployment.replicas_available{kube_cluster_name:test-cluster} by {kube_namespace,kube_deployment} / avg:kubernetes_state.deployment.replicas_desired{kube_cluster_name:test-cluster} by {kube_namespace,kube_deployment}) < 0.8",
    "renotify_interval": 30,
    "renotify_statuses": [
