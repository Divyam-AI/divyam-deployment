{
  "datadog_monitor.alerts[\"clickhouse-disk-usage-high\"]": {
    "include_tags": true,
    "message": "ClickHouse disk {{disk_name.name}} on {{host.name}} (cluster {{kube_cluster_name.name}}) has exceeded disk usage thresholds (warn 80%, critical 90%).\n\n@webhook-divyam-pager-0",
    "monitor_thresholds": [
      {
        "critical": "90",
        "critical_query": null,
        "critical_recovery": "85",
        "critical_recovery_query": null,
        "ok": null,
        "unknown": null,
        "warning": "80",
        "warning_recovery": "75"
      }
    ],
    "name": "clickhouse-disk-usage-high",
    "no_data_timeframe": 15,
    "notify_no_data": true,
    "priority": "3",
    "query": "max(last_15m):(avg:clickhouse.disks.total_space{kube_cluster_name:test-cluster} by {host,disk_name} - avg:clickhouse.disks.free_space{kube_cluster_name:test-cluster} by {host,disk_name}) / avg:clickhouse.disks.total_space{kube_cluster_name:test-cluster} by {host,disk_name} * 100 > 90",
    "renotify_interval": 30,
    "renotify_statuses": [
      "alert",
      "warn"
    ],
    "require_full_window": true,
    "tags": [
      "alert_rule:AlwaysOn",
      "cluster:test-cluster",
      "env:preprod",
      "managed-by:terraform",
      "rule_group:ClickHouse",
      "rule_group:clickhouse",
      "severity:WARNING"
    ],
    "timeout_h": null,
    "type": "metric alert"
  },
