  {
    "alert": "deployment-replica-mismatch",
    "auto_resolve": "30m",
    "dashboard_url": null,
    "description": "Warn when < 90% replicas available; critical when < 80%; recover above 85% (crit) / 95% (warn)",
    "enabled": true,
    "expr": "(kube_deployment_status_replicas_available / kube_deployment_spec_replicas) < 0.8",
    "for": "2m",
    "gcp_notification_channels": null,
    "group_description": "Kubernetes alerts (deployment / pod / pvc / statefulset health).",
    "group_enabled": true,
    "group_name": "k8s",
    "group_title": "kubernetes",
    "interval": "1m",
    "labels": {
      "alert_rule": "AlwaysOn",
      "rule_group": "Kubernetes"
    },
    "notify": false,
    "renotify_interval": null,
    "runbook_url": "https://runbooks.divyam.ai/kubernetes/deployment-replica-mismatch",
    "severity": "CRITICAL",
    "summary": "Deployment Replica Mismatch"
  },
