  {
    "alert": "kafka-consumer-lag-growing",
    "auto_resolve": "15m",
    "dashboard_url": null,
    "description": "Consumer group lag is growing at more than {{threshold}} messages over 10 minutes, suggesting the consumer cannot keep up with the producer.",
    "enabled": true,
    "expr": "max by (consumergroup, topic) (deriv(kafka_consumergroup_lag{namespace=\"kafka-preprod-ns\"}[10m])) > 1000",
    "for": "10m",
    "gcp_notification_channels": null,
    "group_description": "Kafka broker health, consumer lag, and storage alerts",
    "group_enabled": true,
    "group_name": "kafka",
    "group_title": "kafka",
    "interval": "1m",
    "labels": {
      "rule_group": "Kafka"
    },
    "notify": false,
    "renotify_interval": null,
    "runbook_url": null,
    "severity": "WARNING",
    "summary": "Kafka consumer lag growing steadily (P2)"
  },
  {
    "alert": "kafka-consumer-lag-sla",
    "auto_resolve": "10m",
    "dashboard_url": null,
    "description": "Consumer group lag has exceeded {{threshold}} messages for more than 10 minutes. Tune threshold to match your team's SLA.",
    "enabled": true,
    "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag{namespace=\"kafka-preprod-ns\"}) > 50000",
    "for": "10m",
    "gcp_notification_channels": null,
    "group_description": "Kafka broker health, consumer lag, and storage alerts",
    "group_enabled": true,
    "group_name": "kafka",
    "group_title": "kafka",
    "interval": "1m",
    "labels": {
      "rule_group": "Kafka"
    },
    "notify": true,
    "renotify_interval": null,
    "runbook_url": null,
    "severity": "WARNING",
    "summary": "Kafka consumer lag exceeds SLA (P1)"
  },
  {
    "alert": "kafka-disk-full",
    "auto_resolve": "10m",
    "dashboard_url": null,
    "description": "Kafka PVC is over 90% capacity. Write failures are imminent. Expand storage or purge topic data immediately.",
    "enabled": true,
    "expr": "max by (namespace, persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"kafka-preprod-ns\"} / kubelet_volume_stats_capacity_bytes{namespace=\"kafka-preprod-ns\"} * 100) > 90",
    "for": "5m",
    "gcp_notification_channels": null,
    "group_description": "Kafka broker health, consumer lag, and storage alerts",
    "group_enabled": true,
    "group_name": "kafka",
