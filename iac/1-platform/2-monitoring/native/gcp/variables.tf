variable "enabled" {
  type    = bool
  default = true
}

variable "project_id" {
  type = string
}

variable "region" {
  description = "GKE cluster region (same as 1-k8s/gcp)."
  type        = string
}

variable "location" {
  description = "GKE cluster location (same as 1-k8s/gcp). A zone for a zonal cluster; null falls back to region."
  type        = string
  default     = null
}

variable "cluster_name" {
  description = "GKE cluster name from values k8s.name (or monitoring.native.gmp_cluster_name override)."
  type        = string
  default     = null
}

variable "enable_workload_logs" {
  type    = bool
  default = true
}

variable "enable_cluster_logs" {
  type    = bool
  default = true
}

variable "enable_managed_prometheus" {
  type    = bool
  default = false
}

variable "metrics_components" {
  description = "GKE components that export metrics to Managed Prometheus (monitoring_config.enable_components). Used when enable_managed_prometheus is true."
  type        = list(string)
  nullable    = false
  default = [
    "SYSTEM_COMPONENTS",
    # kube-state metrics: pod phase, container waiting/terminated reasons, restarts, ready replicas, jobs, PV/PVC.
    "STORAGE",
    "HPA",
    "POD",
    "DAEMONSET",
    "DEPLOYMENT",
    "STATEFULSET",
    "JOBSET",
    # cAdvisor + kubelet: container usage, kubelet volume stats.
    "CADVISOR",
    "KUBELET",
  ]
}

variable "logs_retention_days" {
  type    = number
  default = 30
}

variable "manage_project_log_bucket" {
  type    = bool
  default = true
}

# common_tags, tag_globals, tag_context — from root.hcl generate "tagging" (zz_autogenerated_tags.tf)
