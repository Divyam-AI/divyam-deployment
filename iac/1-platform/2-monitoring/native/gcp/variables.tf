variable "enabled" {
  type    = bool
  default = true
}

variable "project_id" {
  type = string
}

variable "region" {
  description = "GKE cluster region (same as 1-k8s/gcp)."
  type        = string
}

variable "cluster_name" {
  description = "GKE cluster name from values k8s.name (or monitoring.native.gmp_cluster_name override)."
  type        = string
  default     = null
}

variable "enable_workload_logs" {
  type    = bool
  default = true
}

variable "enable_cluster_logs" {
  type    = bool
  default = true
}

variable "enable_managed_prometheus" {
  type    = bool
  default = false
}

variable "logs_retention_days" {
  type    = number
  default = 30
}

variable "manage_project_log_bucket" {
  type    = bool
  default = true
}

variable "enable_cloudsql_backup_metric" {
  description = "Create the log-based metric that counts Cloud SQL automated backup windows by outcome. Covers every Cloud SQL instance in the project."
  type        = bool
  default     = true
}

variable "uptime_checks" {
  description = "Public HTTPS endpoints to watch with a Google Cloud uptime check, by name. Empty means none. host is the DNS name only, without https://."
  type = map(object({
    host    = string
    path    = optional(string, "/")
    period  = optional(string, "60s")
    timeout = optional(string, "10s")
  }))
  default = {}
}

variable "cloudsql_backup_metric_name" {
  description = "Name of that metric. Alert policies read it as logging.googleapis.com/user/<name>."
  type        = string
  default     = "divyam_cloudsql_automated_backup"
}

# common_tags, tag_globals, tag_context — from root.hcl generate "tagging" (zz_autogenerated_tags.tf)
